# ══════════════════════════════════════════════════════════════════════════════
# Application Configuration
# ══════════════════════════════════════════════════════════════════════════════
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ENABLED=true

# ══════════════════════════════════════════════════════════════════════════════
# Database Configuration - Supabase
# ══════════════════════════════════════════════════════════════════════════════
DATABASE_HOST=db.xxxxxxxxxxxxxxxxxxxxx.supabase.co
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your-database-password-here
DATABASE_NAME=postgres
DATABASE_SSL=true
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT=5000

# ══════════════════════════════════════════════════════════════════════════════
# TypeORM Configuration
# ══════════════════════════════════════════════════════════════════════════════
# WARNING: Never set TYPEORM_SYNCHRONIZE=true in production!
# Use hand-written migrations in database/sql/migrations/
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=true
