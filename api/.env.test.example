# Test Environment Configuration
# Copy this file to .env.test and fill in your Supabase test database credentials

# Database Connection
DB_HOST=your-supabase-host.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-test-database-password
DB_DATABASE=postgres
DB_SCHEMA=public

# Enable query logging (optional, useful for debugging)
DB_LOGGING=false

# Note: Use a SEPARATE test database or schema from your development database
# to avoid data conflicts.
