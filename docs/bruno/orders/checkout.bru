meta {
  name: Checkout
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/orders/checkout
  body: json
  auth: inherit
}

body:json {
  {
    "addressId": 1
  }
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Response has order id", function() {
    expect(res.body.id).to.be.a('number');
  });

  test("Status is PendingPayment", function() {
    expect(res.body.status).to.equal('PendingPayment');
  });

  test("Payment status is Pending", function() {
    expect(res.body.paymentStatus).to.equal('Pending');
  });
}
