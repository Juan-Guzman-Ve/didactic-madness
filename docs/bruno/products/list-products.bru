meta {
  name: List Products with Filters
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/products?search=Intel&minPrice=100&sort=price:desc
  body: none
  auth: none
}

query {
  ~search: Intel
  ~categoryId: 1
  ~minPrice: 100
  ~maxPrice: 1000
  ~brand: Intel
  ~inStock: true
  ~sort: price:desc
  ~page: 1
  ~limit: 10
}
