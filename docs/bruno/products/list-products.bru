meta {
  name: List Products with Filters
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/products?search=Intel&minPrice=100&sort=price:desc
  body: none
  auth: none
}

params:query {
  search: Intel
  minPrice: 100
  sort: price:desc
  ~search: Intel
  ~categoryId: 1
  ~minPrice: 100
  ~maxPrice: 1000
  ~brand: Intel
  ~inStock: true
  ~sort: price:desc
  ~page: 1
  ~limit: 10
}

script:post-response {
  const response = res.body; 
  
  
  const rowData = response.data.map(item => ({
    id: item.id,
    name: item.name,
    stock: item.stock,
    status: item.status
  }));
  
  const columnDefinitions = [
    { field: 'id', headerName: 'ID', width: 80 },
    { field: 'name', headerName: 'Product Name', flex: 1 },
    { field: 'stock', headerName: 'Stock', width: 100 },
    { field: 'status', headerName: 'Status', width: 120 }
  ];
  
  bru.visualize('table', {
    name: 'Filtered Inventory Table',
    provider: 'ag-grid',
    props: {
      rowData: rowData,
      columnDefinitions: columnDefinitions
    }
  });
}
