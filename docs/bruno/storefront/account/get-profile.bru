meta {
  name: Get My Profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/account
  body: none
  auth: inherit
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Profile has id", function() {
    expect(res.body.id).to.be.a('number');
  });

  test("Profile has email", function() {
    expect(res.body.email).to.be.a('string');
  });
}
