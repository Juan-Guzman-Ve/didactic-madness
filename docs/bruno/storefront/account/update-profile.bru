meta {
  name: Update My Profile
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/account
  body: json
  auth: inherit
}

body:json {
  {
    "firstName": "John",
    "lastName": "Doe",
    "phone": "+1234567890"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
