meta {
  name: Push Order Status
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/order-status-histories
  body: json
  auth: inherit
}

body:json {
  {
    "orderId": 1,
    "status": "Paid",
    "changedByUserId": 1,
    "notes": "Payment confirmed via card"
  }
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Response has orderId", function() {
    expect(res.body.orderId).to.be.a('number');
  });
}
