meta {
  name: List Products
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/products
  body: none
  auth: inherit
}

params:query {
  ~page: 1
  ~limit: 20
  ~search: RTX
  ~categoryId: 1
  ~brand: NVIDIA
  ~sort: createdAt:desc
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response has data array", function() {
    expect(res.body.data).to.be.an('array');
  });
}
